# ============================================================================
#  AI Blue Team Bootcamp — central lab configuration
#  Copy to .env  (cp .env.example .env)  and edit for your environment.
#  Every script and container reads these values, so you switch between the
#  real cyberlab VMs and the local Docker fallback WITHOUT editing code.
# ============================================================================

# ---- Ollama (GPU VM) --------------------------------------------------------
# Real cyberlab GPU VM:
#   OLLAMA_HOST=http://10.50.142.235:11434
# Local Docker fallback (mock, no GPU needed):
#   OLLAMA_HOST=http://mock-ollama:11434     (from inside docker network)
#   OLLAMA_HOST=http://localhost:11435       (from your laptop; host port = MOCK_OLLAMA_PORT below)
OLLAMA_HOST=http://10.50.142.235:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Wazuh VM ---------------------------------------------------------------
WAZUH_API=https://10.50.136.116:55000
WAZUH_DASHBOARD=https://10.50.136.116
WAZUH_USER=wazuh-wui
# Password generated at install time — paste the real one here.
WAZUH_PASS=CHANGE_ME
# The indexer (OpenSearch) endpoint used to query stored alerts directly.
WAZUH_INDEXER=https://10.50.136.116:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=CHANGE_ME
# Set to 0 in the lab since Wazuh uses self-signed certs. NEVER do this in prod.
VERIFY_TLS=0

# ---- Dockerized lab endpoints (Module 2 & 4) --------------------------------
VICTIM_WEB_PORT=8081
VICTIM_SSH_PORT=2222
AI_SOC_PORT=8080
# Host publish port for the local mock (11434 is often taken by a real local Ollama).
MOCK_OLLAMA_PORT=11435

# ---- AI SOC Assistant behaviour ---------------------------------------------
# vulnerable | hardened   (Module 4 flips this to demonstrate defenses)
AI_SOC_MODE=vulnerable
# The model endpoint the ASSISTANT container uses (separate from OLLAMA_HOST above,
# which is for host-side scripts). Default = the deterministic mock, so the Module 4
# attack/defense demo is reliable. Point it at the GPU VM to use the real model:
#   AI_SOC_OLLAMA_HOST=http://10.50.142.235:11434
AI_SOC_OLLAMA_HOST=http://10.50.142.235:11434
