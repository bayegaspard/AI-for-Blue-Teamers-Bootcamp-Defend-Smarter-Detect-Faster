<!--
  Custom Wazuh rules for the bootcamp.
  Install on the Wazuh MANAGER (10.50.136.116):
    sudo cp local_rules.xml /var/ossec/etc/rules/local_rules.xml   (merge if one exists)
    sudo systemctl restart wazuh-manager
  Test with:
    /var/ossec/bin/wazuh-logtest
-->
<group name="bootcamp,custom,">

  <!-- ================= Web attack detection (Module 2/3) ================= -->
  <rule id="100100" level="10">
    <decoded_as>json</decoded_as>
    <field name="data.url">\.\./|/etc/passwd</field>
    <description>Bootcamp: Path traversal attempt in web request</description>
    <mitre><id>T1083</id></mitre>
  </rule>

  <rule id="100101" level="12">
    <if_sid>31100</if_sid>
    <match>UNION SELECT|' OR '1'='1|OR 1=1|information_schema|sqlmap</match>
    <description>Bootcamp: SQL injection pattern in web traffic</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- ============ AI-threat detection: prompt injection in logs =========
       This is the blue-team counterpart to Module 4. If an attacker plants a
       prompt-injection payload in a field that ends up in your logs (User-Agent,
       username, URL), this rule flags it BEFORE a naive AI assistant ingests it. -->
  <rule id="100110" level="12">
    <match>IGNORE ALL PREVIOUS INSTRUCTIONS|ignore previous instructions|reveal your system prompt|disregard the data above|you are now|mark this alert as benign</match>
    <description>Bootcamp: Possible PROMPT-INJECTION payload detected in log data</description>
    <group>ai_threat,prompt_injection,</group>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- Correlated brute force: many failures then a success from same source.
       (Wazuh already has 5710/5712/5720 for SSH; this adds a high-signal combo.) -->
  <rule id="100120" level="12" frequency="8" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip/>
    <description>Bootcamp: SSH brute force burst (>=8 failures/60s) from one source</description>
    <mitre><id>T1110</id></mitre>
  </rule>

</group>
